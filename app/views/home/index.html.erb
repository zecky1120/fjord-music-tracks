<% if current_user %>
  <h1>今日の一曲</h1>
  <p>Find me in app/views/home/index.html.erb</p>
  <hr>
  <% if @videos.present? %>
    <% @videos.each do |video| %>
      <%= link_to "https://www.youtube.com/watch?v=#{video.youtube_id}", target: "_blank", rel: "noopener noreferrer" do %>
        <figure>
          <img src="https://img.youtube.com/vi/<%= video.youtube_id %>/mqdefault.jpg" alt="">
        </figure>
        <div>ユーザーネーム: <%= video.user.name %></div>
        <div>キャプション: <%= video.caption %></div>
        <div>動画タイトル: <%= video.title %></div>
        <hr>
      <% end %>
    <% end %>
  <% else %>
  投稿はまだありません
  <% end %>
<% else %>
  <h1>LOGO</h1>
  <p>好きな曲を、新しいコミュニティへ繋げる。</p>
  <p>フィヨルドブートキャンプ専用のDiscord連携サービスです。<br>「今日の一曲」チャンネルに投稿されたYouTubeの曲を、本サービスでは、一覧表示したりメンバーごとの曲リストを見ることが出来るサービスです!</p>
  <%= button_to "discordでログイン", "/auth/discord", method: :post, data: { turbo: false } %>
<% end %>
